# Fichier .env.testing — Laravel le charge automatiquement quand APP_ENV=testing
# (notamment via `php artisan test` ou phpunit)

APP_ENV=testing
APP_DEBUG=true


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_boutique_test
DB_USERNAME=ndiaga
DB_PASSWORD=Ndiaga123@

# JWT nécessaire aussi en test
JWT_SECRET=

# Mailer en mode log pour ne pas envoyer de vrais emails pendant les tests
MAIL_MAILER=log